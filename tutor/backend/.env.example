# Copy to .env and fill in. All settings are optional except the API key.

# --- required for real LLM calls ---
TUTOR_ANTHROPIC_API_KEY=sk-ant-...

# --- infrastructure ---
TUTOR_DATABASE_URL=sqlite+aiosqlite:///./tutor.db
# Postgres instead (docker compose --profile postgres up):
# TUTOR_DATABASE_URL=postgresql+asyncpg://tutor:tutor@localhost:5432/tutor
TUTOR_CORS_ORIGINS=["http://localhost:5173"]
TUTOR_DEBUG=false

# --- LLM ---
# "fake" runs the deterministic offline adapter: no network, no key needed.
TUTOR_LLM_PROVIDER=anthropic
TUTOR_LLM_MODEL=claude-opus-5
TUTOR_PROMPT_CACHING=true
# Reasoning depth: low | medium | high | xhigh | max.
TUTOR_LLM_EFFORT=medium
TUTOR_LLM_REASONING_EFFORT=high
# If the model's safety classifiers decline a request, rerun it on this model
# within the same call instead of returning an empty response.
TUTOR_LLM_SERVER_SIDE_FALLBACK=true
TUTOR_LLM_FALLBACK_MODEL=claude-opus-4-8

# --- mastery model tuning ---
# These defaults are calibrated against the synthetic learner in the test suite.
# Changing one means re-running tests/test_mastery_synthetic.py.
TUTOR_ELO_BASE_STEP=0.9
TUTOR_PROPAGATION_DECAY=0.5
TUTOR_PROPAGATION_MAX_HOPS=4
TUTOR_PREREQ_BOUND_SLACK=0.06
TUTOR_MASTERY_HALF_LIFE_DAYS=60
TUTOR_MASTERY_THRESHOLD=0.7

# --- diagnostic ---
TUTOR_DIAGNOSTIC_MAX_ITEMS=30
TUTOR_DIAGNOSTIC_CONFIDENCE_TARGET=0.55

# --- scheduling ---
TUTOR_TARGET_RETENTION=0.85
TUTOR_DAILY_REVIEW_CAP=20
# Freshly taught concepts follow a fixed 1/3/7/21-day ladder before FSRS takes over.
TUTOR_USE_ACQUISITION_LADDER=true
TUTOR_FSRS_RELEARNING_MINUTES=[10,1440]
TUTOR_DEFAULT_DAYS_PER_WEEK=4
TUTOR_DEFAULT_MINUTES_PER_SESSION=20

# --- optional integrations (off by default) ---
TUTOR_ENABLE_CALENDAR=false
TUTOR_ENABLE_RECOVERY_SIGNAL=false
